---
import Layout from '../layouts/Layout.astro';

const links = [
  { href: '/solar-systems-homes-villas/', label: 'محطات الطاقة الشمسية للمنازل والفيلات' },
  { href: '/solar-factories-hotels/', label: 'الطاقة الشمسية للمصانع والفنادق' },
  { href: '/solar-irrigation-pumps/', label: 'الري بالطاقة الشمسية ومضخات الآبار' },
  { href: '/hybrid-batteries-maintenance/', label: 'الأنظمة الهجينة والبطاريات والصيانة' },
  { href: '/solar-prices-egypt/', label: 'دليل أسعار الطاقة الشمسية في مصر' },
  { href: '/electricity-bill-calculator/', label: 'حاسبة فاتورة الكهرباء' },
  { href: '/solar-egypt-governorates/', label: 'الطاقة الشمسية في محافظات مصر' },
  { href: '/blog/', label: 'المقالات والأدلة' },
];
---

<Layout
  title="الصفحة غير موجودة | شمس الوادي للطاقة الشمسية"
  description="لم نجد الصفحة التي تبحث عنها. تصفح خدمات الطاقة الشمسية ودليل الأسعار وصفحات المحافظات، أو تواصل معنا مباشرة."
  noindex
>

<section style="background:linear-gradient(135deg, #08344B 0%, #0E4D6E 65%, #08344B 100%);padding:72px 24px;">
  <div style="max-width:860px;margin:0 auto;">
    <span style="display:inline-block;margin-bottom:12px;padding:4px 12px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:0.12em;background:rgba(143,208,234,0.18);color:#8FD0EA;border:1px solid rgba(143,208,234,0.3);">خطأ 404</span>
    <h1 style="font-family:'IBM Plex Sans Arabic', 'Noto Kufi Arabic', system-ui, sans-serif;font-weight:800;color:#fff;line-height:1.1;font-size:clamp(30px,4.4vw,48px);margin:0 0 14px;">لم نجد هذه الصفحة</h1>
    <p style="font-size:18px;line-height:1.7;color:rgba(255,255,255,0.85);max-width:560px;margin:0 0 28px;">ربما تغيّر الرابط أو كُتب بشكل غير صحيح. ابدأ من إحدى الصفحات التالية، أو تواصل معنا مباشرة.</p>
    <div style="display:flex;flex-wrap:wrap;gap:16px;">
      <a href="tel:+201283355408" class="btn-cream">اتصل الآن <bdi>+20 128 335 5408</bdi></a>
      <a href="/" class="btn-outline-white">الصفحة الرئيسية</a>
    </div>
  </div>
</section>

<section style="padding:56px 24px 80px;">
  <div style="max-width:860px;margin:0 auto;">
    <h2 class="section-heading" style="font-size:clamp(22px,3vw,30px);margin:0 0 22px;">صفحات يبحث عنها زوارنا</h2>
    <ul class="nf-links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .nf-links { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .nf-links a { display: flex; align-items: center; min-height: 56px; padding: 12px 18px; background: #fff; border: 1px solid #D8E3EA; border-radius: 12px; font-size: 15px; font-weight: 700; color: #0A3D5C; text-decoration: none; transition: border-color 0.2s, color 0.2s; }
  .nf-links a:hover { border-color: #1273A8; color: #1273A8; }
  .nf-links a:focus-visible { outline: 2px solid #1273A8; outline-offset: 2px; }
  @media (max-width: 600px) { .nf-links { grid-template-columns: 1fr; } }
</style>
</Layout>

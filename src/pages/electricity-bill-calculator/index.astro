<script type="application/json" id="tariff-data" set:html={JSON.stringify(TARIFF)} />
<script is:inline>
  (function () {
    var el = document.getElementById('kwh');
    if (!el) return;
    var dataEl = document.getElementById('tariff-data');
    var T = JSON.parse(dataEl.textContent);
    var byN = {};
    T.forEach(function (t) { byN[t.n] = t; });

    // Mirrors the server-side billFor(). Rates come from the shared TARIFF table.
    function bill(k) {
      var r1 = byN[1].rate, r2 = byN[2].rate, r3 = byN[3].rate,
          r4 = byN[4].rate, r5 = byN[5].rate, r6 = byN[6].rate, r7 = byN[7].rate;
      if (k <= 0) return { total: 0, tier: 1, whole: false };
      if (k <= 50) return { total: k * r1, tier: 1, whole: false };
      if (k <= 100) return { total: 50 * r1 + (k - 50) * r2, tier: 2, whole: false };
      if (k <= 200) return { total: k * r3, tier: 3, whole: false };
      if (k <= 350) return { total: 200 * r3 + (k - 200) * r4, tier: 4, whole: false };
      if (k <= 650) return { total: 200 * r3 + 150 * r4 + (k - 350) * r5, tier: 5, whole: false };
      if (k <= 1000) return { total: k * r6, tier: 6, whole: true };
      return { total: k * r7, tier: 7, whole: true };
    }

    var fmt = function (x) {
      return (Math.round(x * 100) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };
    var amountEl = document.getElementById('amount');
    var tierEl = document.getElementById('tier');
    var rateEl = document.getElementById('rate-line');
    var warnEl = document.getElementById('warn');

    function render() {
      var k = parseFloat(el.value);
      if (isNaN(k) || k < 0) {
        amountEl.textContent = '—';
        tierEl.textContent = '—';
        rateEl.textContent = '';
        warnEl.hidden = true;
        return;
      }
      var res = bill(k);
      amountEl.textContent = fmt(res.total);
      tierEl.textContent = 'الشريحة ' + res.tier + ' — ' + byN[res.tier].label;
      rateEl.innerHTML = res.whole
        ? 'استهلاكك كله يُحسب بسعر <strong>' + byN[res.tier].rate + ' جنيه</strong> للكيلوواط ساعة من أول وحدة.'
        : 'متوسط سعر الكيلوواط ساعة على فاتورتك: <strong>' + (k > 0 ? fmt(res.total / k) : '0') + ' جنيه</strong>.';

      // Warn when the next cliff is close enough to matter.
      warnEl.hidden = true;
      if (k > 560 && k <= 650) {
        var d = bill(651).total - res.total;
        warnEl.innerHTML = 'أنت على بعد ' + Math.round(651 - k) + ' ك.و.س من الشريحة السادسة. تجاوزها يرفع قيمة استهلاكك بنحو <strong>' + fmt(d) + ' جنيه</strong> دفعة واحدة.';
        warnEl.hidden = false;
      } else if (k > 650 && k <= 1000) {
        var save = res.total - bill(650).total;
        warnEl.innerHTML = 'أنت داخل الشريحة السادسة، ويُحسب استهلاكك كله بسعرها. النزول تحت 650 ك.و.س يوفر نحو <strong>' + fmt(save) + ' جنيه</strong> شهرياً.';
        warnEl.hidden = false;
      } else if (k > 1000) {
        var save2 = res.total - bill(1000).total;
        warnEl.innerHTML = 'أنت في الشريحة السابعة، أعلى شريحة. النزول تحت 1000 ك.و.س وحده يوفر نحو <strong>' + fmt(save2) + ' جنيه</strong> شهرياً.';
        warnEl.hidden = false;
      }
    }

    el.addEventListener('input', render);
    render();
  })();
</script>


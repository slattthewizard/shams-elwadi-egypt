    <h2 class="section-heading" style="font-size:clamp(22px,3vw,32px);margin:0 0 28px;">خدماتنا في الوادي الجديد</h2>
    <div class="feat-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;">

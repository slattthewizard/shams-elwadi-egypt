---
// "Related articles" block for service and governorate pages: links hand-picked
// blog posts by slug, in the order given. Slugs not (yet) in the collection are skipped.
import { getCollection } from 'astro:content';

export interface Props {
  slugs: string[];
  heading?: string;
}

const { slugs, heading = 'مقالات تفيدك قبل القرار' } = Astro.props;
const bySlug = new Map((await getCollection('blog')).map((p) => [p.slug, p]));
const posts = slugs.map((s) => bySlug.get(s)).filter(Boolean);
---

{posts.length > 0 && (
  <section style="padding:56px 24px;">
    <div style="max-width:1100px;margin:0 auto;">
      <h2 class="section-heading" style="font-size:clamp(22px,3vw,32px);margin:0 0 24px;">{heading}</h2>
      <div class="related-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="related-card">
            {post.data.tag && <span class="related-tag">{post.data.tag}</span>}
            <span class="related-title">{post.data.title}</span>
            <span class="related-desc">{post.data.metaDescription}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
  .related-card { display: flex; flex-direction: column; gap: 8px; background: #fff; border: 1px solid #DCEAF2; border-radius: 14px; padding: 20px; text-decoration: none; box-shadow: 0 4px 16px rgba(10,61,92,0.06); transition: box-shadow 0.2s, transform 0.2s; }
  .related-card:hover { box-shadow: 0 10px 26px rgba(10,61,92,0.14); transform: translateY(-2px); }
  .related-tag { align-self: flex-start; font-size: 12px; font-weight: 700; color: #1273A8; background: #EAF5FB; border-radius: 999px; padding: 3px 10px; }
  .related-title { font-family: 'IBM Plex Sans Arabic', 'Noto Kufi Arabic', system-ui, sans-serif; font-size: 17px; font-weight: 800; line-height: 1.45; color: #0A3D5C; }
  .related-desc { font-size: 14px; line-height: 1.7; color: #4A5A64; }
</style>
